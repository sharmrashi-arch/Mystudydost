# Copy this file to .env and fill your keys. NEVER commit .env
GROQ_API_KEY=your_groq_api_key_here
SERP_API_KEY=your_serp_api_key_here

# Model names (must be available in your Groq account; change freely)
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_MODEL_STT=whisper-large-v3-turbo

APP_NAME=BrainBuddy
APP_ENV=development